<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_bg" android:padding="12dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_chip" android:layout_width="wrap_content" android:layout_height="26dp" android:adjustViewBounds="true" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_dest" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/w_ink" android:maxLines="1" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/w_ink" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp"/>
    <TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12.5sp" android:textStyle="normal" android:textColor="@color/w_mute" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_from" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12.5sp" android:textStyle="normal" android:textColor="@color/w_mute" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
