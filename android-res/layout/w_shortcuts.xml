<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/w_bg" android:padding="10dp" android:gravity="center_vertical">
    <LinearLayout android:id="@+id/w_sc0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:background="@drawable/w_tile" android:src="@drawable/w_ic_map" android:contentDescription="Carte" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Carte" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/w_ink" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_sc1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:background="@drawable/w_tile" android:src="@drawable/w_ic_search" android:contentDescription="Recherche" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Recherche" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/w_ink" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_sc2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:background="@drawable/w_tile" android:src="@drawable/w_ic_heart" android:contentDescription="Favoris" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Favoris" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/w_ink" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_sc3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:background="@drawable/w_tile" android:src="@drawable/w_ic_mail" android:contentDescription="Infos trafic" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Infos trafic" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/w_ink" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
