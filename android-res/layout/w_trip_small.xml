<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_bg" android:padding="10dp" android:gravity="center">
    <ImageView android:id="@+id/w_chip" android:layout_width="wrap_content" android:layout_height="26dp" android:adjustViewBounds="true" android:importantForAccessibility="no" />
    <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/w_ink" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/w_dest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="normal" android:textColor="@color/w_mute" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
