        <TextView android:id="@+id/ta3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/w_ink" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="6dp"/>
        <TextView android:id="@+id/tb3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="normal" android:textColor="@color/w_mute" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp"/>
    </LinearLayout>
