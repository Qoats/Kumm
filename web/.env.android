# Adresse de votre serveur Kumm, utilisée par l'application Android (APK).
# Le jeton CTS reste sur le serveur : il n'est JAMAIS dans l'APK.
# La clé d'application (VITE_APP_KEY), elle, est dans l'APK : elle n'est pas un secret absolu,
# elle bloque seulement les appels extérieurs simples.
#
# Test sur le réseau local (PC et téléphone sur le même Wi-Fi) : l'adresse de votre PC, port 3000
#   VITE_API_BASE=http://192.168.1.25:3000        (exemple : remplacez par l'adresse de VOTRE PC)
# Utilisation partout : serveur hébergé en ligne, en https
#   VITE_API_BASE=https://app.kumm.fr
VITE_API_BASE=https://app.kumm.fr
#
# Clé d'application : la même que APP_KEY sur le serveur (voir .env.example).
# Si le serveur n'exige aucune clé, laissez la ligne en commentaire.
# VITE_APP_KEY=
