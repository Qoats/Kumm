# Caddy : obtient et renouvelle seul les certificats HTTPS. Chaque nom ci-dessous doit pointer vers ce serveur (DNS).

# --- Site vitrine : kumm.fr (fichiers du dossier « vitrine ») ---
kumm.fr {
	root * /srv/site
	encode zstd gzip
	file_server
	# pages : le navigateur redemande toujours si elles ont changé (sinon il garde l'ancienne version des heures)
	@pages path / *.html
	header @pages Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
	}
}

www.kumm.fr {
	redir https://kumm.fr{uri} permanent
}

# --- Application et serveur Kumm : app.kumm.fr (l'APK Android utilise cette adresse) ---
app.kumm.fr {
	reverse_proxy kumm:3000 {
		# l'application gère elle-même la compression et ses délais
		transport http {
			dial_timeout 5s
			response_header_timeout 40s
		}
	}
}

# --- Messagerie Relais : relais.kumm.fr (projet Docker séparé ~/relais, réseau kumm_default) ---
relais.kumm.fr {
	reverse_proxy relais:8080
}
