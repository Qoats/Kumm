# Copiez ce fichier en ".env" et mettez votre token CTS (jamais dans le code, jamais sur GitHub)
CTS_TOKEN=colle-ton-token-ici
PORT=3000

# Optionnel : identifiez votre app auprès des services d'adresses et de marche (recommandé)
# GEO_USER_AGENT=Kumm/0.8 (votre-email@exemple.fr)

# Optionnel : nom envoyé à la CTS comme « RequestorRef » (par défaut : kumm)
# CTS_REQUESTOR=kumm

# --- Réglages du serveur (tous optionnels) ---
# Page de diagnostic /diag : à n'activer qu'en local, JAMAIS sur un serveur public
# ENABLE_DIAG=1
# Limite de requêtes par minute et par adresse (0 = aucune limite)
# RATE_LIMIT_PER_MIN=240
# Derrière un hébergeur (Render, Fly, Railway…) : lit la vraie adresse du visiteur
# TRUST_PROXY=1
# Sites autorisés à appeler le serveur depuis un navigateur (l'APK Android appelle depuis https://localhost)
# CORS_ORIGINS=https://localhost,http://localhost,capacitor://localhost
# Clé d'application : si définie, /api, /geo et /poi exigent l'en-tête X-App-Key (l'application l'envoie via VITE_APP_KEY)
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Avec Docker : ajoutez-la aussi au .env lu par docker compose (build.args), elle est alors intégrée à l'app web
# APP_KEY=

# --- Serveur public (voir docs/MISE-EN-LIGNE.md) ---
# Identifiant envoyé aux services partagés (OpenStreetMap, Base Adresse Nationale, Transitous…) : mettez un vrai contact
# GEO_USER_AGENT=Kumm/0.9 (contact@votre-domaine.fr)
# Nombre maximum de réponses gardées en mémoire, et durée de service « en secours » des passages en direct si la CTS est en panne
# CACHE_MAX_ENTRIES=4000
# STALE_REALTIME_S=120
# Demandes en attente vers la CTS avant de répondre « serveur saturé »
# UPSTREAM_QUEUE_MAX=300
# Passages de tout le réseau rechargés en une fois toutes les N secondes (20 minimum) ; 0 = appel à la CTS arrêt par arrêt
# ET_POLL_S=30
# Requêtes simultanées vers l'extérieur, par file (CTS, autres services)
# UPSTREAM_PARALLEL=4
# Les applications plus anciennes que cette version affichent « mise à jour nécessaire » (dernier recours)
# MIN_APP_VERSION=0.0.0
# Fournisseur de tuiles dédié : adresse de base et clé (ajoutée à chaque tuile, jamais visible dans l'application)
# TILE_BASE=https://fournisseur.example/styles/osm
# TILE_QUERY=?key=VOTRE_CLE
# Plafond d'appels vers la CTS par minute, tous visiteurs confondus : à régler avec les quotas donnés par la CTS (0 = aucun)
# CTS_BUDGET_PER_MIN=1500
# Demandes par minute acceptées pour des arrêts absents de la liste officielle (0 = aucune limite)
# UNKNOWN_REF_PER_MIN=60
# Mettre 0 pour désactiver ce filtrage si des arrêts valables étaient refusés
# VALIDATE_STOP_REFS=1
