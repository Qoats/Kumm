# Modèle du fichier .env à créer SUR LE SERVEUR (copiez-le en « .env » puis complétez).
# Ce fichier contient un secret : ne l'envoyez jamais sur GitHub ni à personne.

# Votre jeton CTS (celui du portail Open Data)
CTS_TOKEN=colle-ton-token-ici

# Un vrai contact : OpenStreetMap, la Base Adresse Nationale et les autres services l'exigent ou l'apprécient
GEO_USER_AGENT=Kumm/1.0 (contact@kumm.fr)

# NE PAS activer sur un serveur public :
# ENABLE_DIAG=1
