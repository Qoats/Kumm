{
  "name": "kumm",
  "version": "0.53.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n serveur,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/kumm.test.mjs tests/android-release.test.mjs tests/android-local.test.mjs tests/walk-graph.test.mjs",
    "build:android": "vite build --mode android && cap sync android",
    "android:open": "cap open android",
    "check:secrets": "node scripts/check-secrets.mjs",
    "build:shapes": "node scripts/build-shapes.mjs",
    "build:pages": "vite build --mode pages --outDir ../dist/pages && node scripts/fetch-open-data.mjs dist/pages"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "maplibre-gl": "6.12.0"
  }
}
